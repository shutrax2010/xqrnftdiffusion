<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/x-icon" href="../assets/favicon.ico">
  <link rel="stylesheet" href="/stylesheets/NftShop.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <title>NFT Shop</title>
  <style>
    /* モーダルのスタイル */
    .modal {
      display: none; 
      position: fixed;
      z-index: 1;
      left: 0;
      top: 0;
      width: 100%;
      height: 100%;
      overflow: auto;
      background-color: rgb(0,0,0);
      background-color: rgba(0,0,0,0.4);
      padding-top: 60px;
    }
    .modal-content {
      background-color: #fefefe;
      margin: 5% auto;
      padding: 20px;
      border: 1px solid #888;
      width: 80%;
    }
    .close {
      color: #aaa;
      float: right;
      font-size: 28px;
      font-weight: bold;
    }
    .close:hover,
    .close:focus {
      color: black;
      text-decoration: none;
      cursor: pointer;
    }
  </style>
</head>
<body>

<header>
  <!-- Header Content -->
</header>

<div class="header-image">
  <img src="../assets/viewer-app6.png" alt="Header Image">
  <div class="header-overlay"></div>
</div>

<div class="header-text">
  <p>Summer Music Festival 2024</p>
</div>

<div id="ipfs-image" class="nft-list">
  <% if (nfts && nfts.length > 0) { %>
    <% nfts.forEach(nft => { %>
      <% if (nft.imageUrl) { %>
        <div class="nft-item">
          <img src="<%= nft.imageUrl %>" alt="<%= nft.name %>" class="nft-image">
          <% if (nft.NFTokenTaxon !== undefined) { %>
            <p>NFTokenTaxon: <%= nft.NFTokenTaxon %></p>
          <% } else { %>
            <p>NFTokenTaxon: Not available</p>
          <% } %>
          <% if (nft.offers && nft.offers.length > 0) { %>
            <button class="button" data-nft-id="<%= nft.id %>" data-offer-id="<%= nft.offers[0].OfferSequence %>" onclick="openModal('<%= nft.id %>', '<%= nft.offers[0].OfferSequence %>')">Check out</button>
          <% } %>
        </div>
      <% } %>
    <% }); %>
  <% } else { %>
    <p>No images found.</p>
  <% } %>
</div>

<script>
  function openModal(nftId, offerId) {
    document.getElementById('confirmModal').style.display = 'block';
    // グローバル変数に選択したNFT IDとオファーIDを保存
    window.currentNftId = nftId;
    window.currentOfferId = offerId;
  }

  function closeModal() {
    document.getElementById('confirmModal').style.display = 'none';
  }

  async function confirmPurchase() {
    const nftId = window.currentNftId;
    const offerId = window.currentOfferId;

    try {
      const response = await fetch('/nftShop/purchase', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ nftId, offerId }),
      });

      const result = await response.json();

      if (result.success) {
        alert('購入が成功しました！');
        // ページのリロードやその他の処理が必要な場合はここに記述
      } else {
        alert('購入に失敗しました。');
      }
    } catch (error) {
      console.error('購入中にエラーが発生しました:', error);
      alert('購入中にエラーが発生しました。');
    }

    closeModal(); // モーダルを閉じる
  }
</script>


<!-- モーダルのHTML -->
<div id="confirmModal" class="modal">
  <div class="modal-content">
    <span class="close" onclick="closeModal()">&times;</span>
    <p>購入を確認しますか？</p>
    <button id="confirmPurchase" onclick="confirmPurchase()">OK</button>
    <button onclick="closeModal()">キャンセル</button>
  </div>
</div>

<footer>
  <!-- Footer Content -->
</footer>





</body>
</html>
